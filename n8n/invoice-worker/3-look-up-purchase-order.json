{
  "name": "Look up purchase order",
  "nodes": [
    {
      "parameters": {
        "inputSource": "jsonExample",
        "jsonExample": "{\n  \"po_number\": \"PO-2026-0433\",\n  \"supplier_id\": \"\"\n}"
      },
      "id": "fa306cf2-c1fe-43b7-8106-bf74ac86bc54",
      "name": "When called by another workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/deals/search",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ filterGroups: [{ filters: [{ propertyName: 'document_type', operator: 'EQ', value: 'purchase_order' }].concat($json.po_number ? [{ propertyName: 'po_number', operator: 'EQ', value: $json.po_number }] : []).concat($json.supplier_id ? [{ propertyName: 'associations.company', operator: 'EQ', value: String($json.supplier_id) }] : []) }], properties: ['dealname','po_number','budget_code','po_requester','dealstage'], limit: 10 }) }}"
      },
      "id": "7d03b900-3676-409a-8232-cdb6475e2057",
      "name": "Search POs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        280,
        0
      ],
      "credentials": {
        "hubspotAppToken": {
          "name": "AppBuilder HubSpot Service Key"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "514fd473-5d7a-4d1f-a600-9f908b8593bf",
              "leftValue": "={{ !!($json.results && $json.results.length > 0) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "002f31af-8354-46c7-b74b-2ba54d030186",
      "name": "POs found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        560,
        0
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "results",
        "options": {}
      },
      "id": "60c7408d-37a4-45c7-a03e-45334e912cae",
      "name": "Split POs",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        840,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/line_items/search",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ filterGroups: [{ filters: [{ propertyName: 'associations.deal', operator: 'EQ', value: $json.id }] }], properties: ['hs_sku','name','quantity','price','received_quantity','delivery_note_ref'], limit: 100 }) }}"
      },
      "id": "9c9ecc18-bc57-40da-82f1-e25c79f51267",
      "name": "Get PO Lines",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        0
      ],
      "credentials": {
        "hubspotAppToken": {
          "name": "AppBuilder HubSpot Service Key"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const pos = $('Split POs').all();\nconst lineResults = $input.all();\nconst out = pos.map((p, i) => {\n  const lines = ((lineResults[i] && lineResults[i].json.results) || []).map((l) => {\n    const ordered = Number(l.properties.quantity) || 0;\n    const received = Number(l.properties.received_quantity) || 0;\n    return { sku: l.properties.hs_sku || '', name: l.properties.name || '', ordered, unit_price: Number(l.properties.price) || 0, received, remaining: Math.max(ordered - received, 0), delivery_note_ref: l.properties.delivery_note_ref || '' };\n  });\n  return { deal_id: p.json.id, po_number: p.json.properties.po_number, budget_code: p.json.properties.budget_code || '', requester: p.json.properties.po_requester || '', stage_id: p.json.properties.dealstage, lines };\n});\nreturn [{ json: { found: true, purchase_orders: out } }];"
      },
      "id": "4b482f8d-b2a9-41ef-a27e-5ab6c59a9f4c",
      "name": "Format POs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{ json: { found: false, purchase_orders: [] } }];"
      },
      "id": "19d79603-dd48-4f6e-b1c3-cb5250b0acdc",
      "name": "No PO",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        180
      ]
    }
  ],
  "connections": {
