          "name": "AppBuilder app key"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Sends one demo invoice email from the app's Email intake page to a monitored mailbox, where the\n// \"Process supplier invoices\" workflow picks it up like any supplier email. Only the monitored\n// mailboxes are allowed, so this webhook can't be used to send mail anywhere else.\nconst ALLOWED = ['daniel@tigros.io', 'demo+invoices@appbuilder.ai'];\nconst b = $json.body || {};\nconst to = String(b.to || '').toLowerCase();\nif (ALLOWED.indexOf(to) < 0) throw new Error('Demo invoices can only go to a monitored mailbox.');\nif (!b.subject || !b.text) throw new Error('subject and text are required.');\nconst out = { json: {\n  to: to,\n  subject: String(b.subject).slice(0, 200),\n  text: String(b.text).slice(0, 5000),\n  sender_name: String(b.sender_name || 'Demo supplier').slice(0, 80) + ' (demo)',\n  demo_id: String(b.demo_id || ''),\n  has_pdf: !!b.pdf_base64\n} };\nif (b.pdf_base64) {\n  const buf = Buffer.from(String(b.pdf_base64), 'base64');\n  if (buf.length > 1024 * 1024) throw new Error('The demo PDF is too large.');\n  out.binary = { data: await this.helpers.prepareBinaryData(buf, String(b.filename || 'invoice.pdf'), 'application/pdf') };\n}\nreturn [out];"
      },
      "id": "032e62de-0efa-4c41-a32b-1fe4b0aeb9b3",
      "name": "Prepare Demo Email",
